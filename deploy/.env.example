# 复制成 deploy/.env 再填。这是占位符，不是真实密钥。
# 有代码默认值的项已经写成和代码一样的占位。不要改成空字符串：
# 空字符串会盖掉默认值。EMBED_DIM、RAG_CACHE_MAX、RAG_AUTO_BATCH、RAG_AUTO_INTERVAL
# 留空会在导入时 int('') 报错，进程起不来。
# 不需要的可选项保持注释，不要写成 KEY= 。

# 数据库账号。下面三行要和 DATABASE_URL 里的用户名、密码、库名一致。
# 密码含 @ : / # 空格时，DATABASE_URL 里要做百分号编码，这里仍写原文。
POSTGRES_USER=gojo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gojo

# 给 app 容器用的连接串。主机名必须是 db，不要写 localhost。
DATABASE_URL=postgresql://gojo:change-me@db:5432/gojo

# 对外域名，只写主机名，不要加 https://，也不要加路径。
SITE_DOMAIN=

# 总开关：claude 或 deepseek。留空会盖掉默认的 claude。
LLM_PROVIDER=claude

# 主模型、日语辅助、中文辅助。和代码默认一致。
MODEL_MAIN=claude-opus-4-6
MODEL_JP_AUX=claude-haiku-4-5-20251001
MODEL_CN_AUX=claude-haiku-4-5-20251001

# Claude 的 key。图片接口认这个，不认 ANTHROPIC_API_KEY 这个名字。
ANTHROPIC_KEY=

# 图片接口的中转地址。不填则走官方，或从设置里的 DEEPSEEK_BASE_URL 推导。
ANTHROPIC_BASE_URL=

# DeepSeek。KEY 留空表示不用。地址和模型名不要留空。
DEEPSEEK_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Fish 语音。KEY 留空表示不做语音。
FISH_KEY=
# 不写 FISH_VOICE_ID 才会用代码里的默认音色。要换再写成 FISH_VOICE_ID=你的音色id
TTS_PROVIDER=fish
# Fish 模型名。不写这行就用代码默认。要改再取消注释。值里有空格，必须加引号。
# FISH_MODEL="s2 Pro"

# Groq 语音转文字。留空则转写接口不可用。
GROQ_KEY=

# 没传 character_id 时用哪个角色。不要留空。
DEFAULT_CHARACTER_ID=default

# 向量检索。USE_RAG 设为 1 才启用。整数项不要留空。
USE_RAG=0
EMBED_API_KEY=
# 不写 EMBED_BASE_URL 时，代码先借用 DEEPSEEK_BASE_URL，再退回内置地址。不要写成空值。
# EMBED_BASE_URL=
EMBED_MODEL=embedding-3
EMBED_DIM=1024
RAG_CACHE_MAX=20000
RAG_AUTO_BATCH=100
RAG_AUTO_INTERVAL=60

# 永久删除角色的管理口令。不需要这个功能就留空。要开至少 32 个字符。
CHARACTER_DELETE_ADMIN_KEY=
